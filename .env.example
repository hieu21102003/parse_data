DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/standards_ai
DB_NAME=standards_ai
DB_USER=postgres
DB_PASSWORD=YOUR_PASSWORD
DB_HOST=localhost
DB_PORT=5432

# Optional Gemini fallback for malformed standard codes
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- HTTP API (src/app/main.py) ---
# Shared secret for other services. When set, parse endpoints require
# the header "X-API-Key: <value>". Leave empty to keep the API open
# (local development only).
PARSER_API_KEY=
# Comma-separated browser origins, or "*". Not needed for server-to-server.
CORS_ORIGINS=*
# Per-file upload limit in MB.
PARSER_MAX_UPLOAD_MB=25

